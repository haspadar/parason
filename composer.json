{
    "name": "haspadar/parason",
    "description": "Per-file coverage thresholds for PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kanstantsinas Mesnikas",
            "email": "haspadar@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "~8.3.16 || ~8.4.3 || ~8.5.0",
        "haspadar/primus": "^0.11.0"
    },
    "require-dev": {
        "haspadar/sheriff": "^0.29.0"
    },
    "autoload": {
        "psr-4": {
            "Haspadar\\Parason\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Haspadar\\Parason\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.16"
        },
        "allow-plugins": {
            "infection/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
